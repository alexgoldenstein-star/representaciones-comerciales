# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominios donde se muestra la landing de venta (separados por coma).
# Cualquier otro dominio se busca en la lista de dominios de vendedores.
VITE_MAIN_HOSTS=representacionescomerciales.com.ar,www.representacionescomerciales.com.ar

# WhatsApp donde querés que te escriban desde la landing (con código de país, sin +)
VITE_CONTACT_WHATSAPP=5491100000000

# Poné "true" para usar los emuladores locales de Firebase (npm run emuladores)
VITE_USE_EMULATORS=false
